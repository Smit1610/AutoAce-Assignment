*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller / Py2exe
*.manifest
*.spec

# Unit tests / Coverage / Typing
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
.mypy_cache/
.pyre/
.pytype/

# Jupyter Notebook
.ipynb_checkpoints

# pyenv
.python-version

# --- Virtual Environments ---
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/
.venv*/

# --- Frontend / Node / Vite ---
node_modules/
*/node_modules/
frontend/dist/
dist-ssr/
*.local

# npm / yarn / pnpm logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Environment & Secret Keys ---
.env
.env.*
!.env.example
*.env

# --- IDEs & Editors ---
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# --- Operating System Files ---
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk

# Linux
.fuse_hidden*
.directory
.Trash-*

# --- Logs & Temp ---
logs/
*.log
tmp/
temp/
